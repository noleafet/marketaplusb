# ---- Core ----
SECRET_KEY=change-me-in-production
DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000
TIME_ZONE=UTC

# ---- Database (PostgreSQL) ----
POSTGRES_DB=grid
POSTGRES_USER=grid
POSTGRES_PASSWORD=gridpass
POSTGRES_PORT=5432
DATABASE_URL=postgresql://grid:gridpass@localhost:5432/grid
# TimescaleDB is optional. When false, the time-series tables are plain
# Postgres tables. Required for Neon, Render, and other managed Postgres.
TIMESCALE_ENABLED=false
# Keep short-lived/zero for Neon and other poolers that autosuspend.
DB_CONN_MAX_AGE=60

# ---- API security ----
# Required in the X-Engine-Token header for all state-changing requests.
ENGINE_API_TOKEN=dev-engine-token-change-me
# Reads are public when true. When false, reads require the same token as mutations.
ENGINE_ALLOW_PUBLIC_READS=true

# ---- Market data ----
# CoinGecko demo key is optional; the public endpoint is used when blank.
COINGECKO_API_KEY=
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3
BINANCE_FUTURES_BASE_URL=https://fapi.binance.com
BINANCE_SPOT_BASE_URL=https://api.binance.com

# ---- Engine ----
ENGINE_LOOKBACK_DAYS=520
ENGINE_INTERVAL=4h
ENGINE_SYMBOL_LIMIT=0
ENGINE_TOP_N_PAPER=8
ENGINE_PAPER_CAPITAL=1000
ENGINE_LEVERAGE=2
ENGINE_MAKER_FEE_RATE=0.0002
ENGINE_TAKER_FEE_RATE=0.0005
ENGINE_SLIPPAGE_BPS=1.0
ENGINE_INITIAL_INVENTORY_PCT=0.0
ENGINE_MIN_ADV_USD=5000000
ENGINE_MIN_OOS_TRADES=12
ENGINE_MAX_DRAWDOWN=0.35
ENGINE_RANGE_LOOKBACK_DAYS=14
ENGINE_GRID_LEVELS=20
ENGINE_ATR_MULTIPLIER=1.0
ENGINE_REBALANCE_DAYS=7
ENGINE_STOP_LOSS_PCT=0.30
ENGINE_WARMUP_BUFFER_DAYS=45

# ---- Paper / live safety ----
PAPER_TICK_MINUTES=5
PAPER_EVAL_MIN_DAYS=7
PAPER_MIN_NET_RETURN=0.01
PAPER_MAX_DRAWDOWN=0.12
PAPER_MIN_TRADES=20
PAPER_HARD_STOP_DRAWDOWN=0.20
PAPER_EVAL_INTERVAL_HOURS=6

# ---- Overbought pause/resume guard ----
# Runs on every paper tick (5 min): 15m RSI > 75 arms a peak trail; exhaustion,
# VWAP loss with MACD decay, or a 1h OI flush flattens to USDT and pauses.
# Recovery needs RSI back above 35 and rising, a 15m close above VWAP, and OI
# turning up.
RISK_GUARD_ENABLED=true
RISK_INTERVAL_SECONDS=300
RISK_RSI_OVERBOUGHT=75
RISK_RSI_RECOVERY=35
RISK_TRAILING_STOP_PCT=0.06
RISK_OI_DROP_PCT=0.05
RISK_OI_NEAR_HIGH_PCT=0.03
RISK_OI_FAILSAFE_MINUTES=60
RISK_ARM_TIMEOUT_HOURS=24
RISK_RECOVERY_COOLDOWN_MINUTES=30

# Live trading is OFF by default. Enabling it also requires a recorded
# approval in the database, API keys, and the kill switch to be released.
LIVE_TRADING_ENABLED=false
BINANCE_FUTURES_TESTNET=true
BINANCE_API_KEY=
BINANCE_API_SECRET=
LIVE_MAX_NOTIONAL_USD=250
LIVE_MAX_DAILY_LOSS_USD=50
LIVE_MAX_LEVERAGE=2
LIVE_SYMBOL_ALLOWLIST=

# ---- Frontend (Next.js server-side proxy) ----
# Both values stay server-side; NEXT_PUBLIC_API_URL is not required.
ENGINE_BACKEND_URL=http://127.0.0.1:8000
# ENGINE_API_TOKEN is re-used by the Next.js proxy.
